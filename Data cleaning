import pandas as pd
n = int(input("Enter number of students: "))

names = []
departments = []
attendance = []
marks = []

for i in range(n):
    print(f"\n--- Student {i + 1} ---")
    name = input("Name: ")
    dept = input("Department: ")
    att = input("Attendance (press Enter if missing): ")
    mark = input("Mark (press Enter if missing): ")

    names.append(name)
    departments.append(dept)
    attendance.append(float(att) if att.strip() != "" else None)
    marks.append(float(mark) if mark.strip() != "" else None)

data = {
    "Name": names,
    "Department": departments,
    "Attendance": attendance,
    "Mark": marks
}

df = pd.DataFrame(data)

print("\n--- Original Dataset ---")
print(df)

print("\nMissing Values:")
print(df.isnull().sum())
df["Attendance"] = df["Attendance"].fillna(df["Attendance"].mean())
df["Mark"] = df["Mark"].fillna(df["Mark"].mean())

df = df.drop_duplicates()

print("\n--- Cleaned Dataset ---")
print(df)

print("\n--- Descriptive Statistics ---")
print(df.describe())

print("\n--- Department-wise Average Marks ---")
print(df.groupby("Department")["Mark"].mean().round(2))

print("\n--- EDA Summary ---")
print("Highest Mark :", df["Mark"].max())
print("Lowest Mark  :", df["Mark"].min())
print("Average Mark :", round(df["Mark"].mean(), 2))
print("Average Attendance :", round(df["Attendance"].mean(), 2))